l%3Aendoscopy+OR+all%3A%22positron+emission%22%29+OR+all%3Aorgan+OR+all%3Alesion+OR+all%3Atumor+OR+all%3Atumour%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-24T01:45:07.862Z","sourceRecordId":"2502.12713v2","queryTrack":"segmentation"},{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Asegmentation+OR+all%3Adelineation+OR+all%3Acontouring%29+AND+%28%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29+OR+all%3Aorgan+OR+all%3Alesion+OR+all%3Atumor+OR+all%3Atumour%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-25T01:20:40.752Z","sourceRecordId":"2502.12713v2","queryTrack":"segmentation"}],"pmid":null,"sources":["arXiv"],"affiliations":[],"tasks":["segmentation"],"modalities":["超声"],"organs":["心血管"],"methods":[],"humanSignals":[],"tracks":["segmentation"],"evidence":[],"reviewStatus":"keyword_candidate","scope":"core","scopeReasons":["医学影像语境","计算方法线索：automated","计算方法线索：proposed method","计算方法线索：datasets"],"scopeClassifierVersion":"2026-10-21-scope-v1","taskClassifierVersion":"2026-10-21-diagnosis-v2"},{"id":"arxiv:2502.14009","arxivId":"2502.14009","title":"Benchmarking Self-Supervised Learning Methods for Accelerated MRI Reconstruction","abstract":"Reconstructing MRI from highly undersampled measurements is crucial for accelerating medical imaging, but is challenging due to the ill-posedness of the inverse problem. While supervised deep learning (DL) approaches have shown remarkable success, they traditionally rely on fully-sampled ground truth (GT) images, which are expensive or impossible to obtain in real scenarios. This problem has created a recent surge in interest in self-supervised learning methods that do not require GT. Although recent methods are now fast approaching \"oracle\" supervised performance, the lack of systematic comparison and standard experimental setups are hindering targeted methodological research and precluding widespread trustworthy industry adoption. We present SSIBench, a modular and flexible comparison framework to unify and thoroughly benchmark Self-Supervised Imaging methods (SSI) without GT. We focus on end-to-end trained DL methods, which do not require long inference time, large datasets, or per-image training. We evaluate 21 such recent methods across seven realistic MRI scenarios on real data, showing a wide performance landscape whose method ranking differs across scenarios and metrics, exposing the need for further SSI research. To accelerate reproducible research and lower the barrier to entry, we provide the extensible benchmark and open-source reimplementations of all methods at https://github.com/Andrewwango/ssibench, allowing researchers to rapidly and fairly contribute and evaluate new methods on the standardised setup for potential leaderboard ranking, or benchmark existing methods on custom datasets, forward operators, or models, unlocking the application of SSI to other valuable nascent GT-free scientific imaging modalities.","originalAbstract":"Reconstructing MRI from highly undersampled measurements is crucial for accelerating medical imaging, but is challenging due to the ill-posedness of the inverse problem. While supervised deep learning (DL) approaches have shown remarkable success, they traditionally rely on fully-sampled ground truth (GT) images, which are expensive or impossible to obtain in real scenarios. This problem has created a recent surge in interest in self-supervised learning methods that do not require GT. Although recent methods are now fast approaching \"oracle\" supervised performance, the lack of systematic comparison and standard experimental setups are hindering targeted methodological research and precluding widespread trustworthy industry adoption. We present SSIBench, a modular and flexible comparison framework to unify and thoroughly benchmark Self-Supervised Imaging methods (SSI) without GT. We focus on end-to-end trained DL methods, which do not require long inference time, large datasets, or per-image training. We evaluate 21 such recent methods across seven realistic MRI scenarios on real data, showing a wide performance landscape whose method ranking differs across scenarios and metrics, exposing the need for further SSI research. To accelerate reproducible research and lower the barrier to entry, we provide the extensible benchmark and open-source reimplementations of all methods at https://github.com/Andrewwango/ssibench, allowing researchers to rapidly and fairly contribute and evaluate new methods on the standardised setup for potential leaderboard ranking, or benchmark existing methods on custom datasets, forward operators, or models, unlocking the application of SSI to other valuable nascent GT-free scientific imaging modalities.","authors":[{"name":"Andrew Wang","affiliations":[],"orcid":null},{"name":"Steven McDonagh","affiliations":[],"orcid":null},{"name":"Mike Davies","affiliations":[],"orcid":null}],"doi":"10.59275/j.melba.2026-b6a3","relatedDoi":"10.59275/j.melba.2026-b6a3","source":"arXiv","status":"preprint","publishedAt":"2025-02-19","updatedAt":"2026-09-11T13:59:33Z","firstSeenAt":"2026-09-18T02:19:09.049Z","venue":"Machine.Learning.for.Biomedical.Imaging. 2026 (2026)","url":"https://arxiv.org/abs/2502.14009v6","version":6,"versions":[{"version":6,"updatedAt":"2026-09-11T13:59:33Z","url":"https://arxiv.org/abs/2502.14009v6"}],"provenance":[{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Areconstruction+OR+all%3Adenoising+OR+all%3A%22super-resolution%22+OR+all%3Asynthesis+OR+all%3A%22artifact+reduction%22%29+AND+%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+al