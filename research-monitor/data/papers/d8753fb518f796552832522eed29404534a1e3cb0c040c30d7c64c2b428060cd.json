[{"id":"arxiv:2202.04785","arxivId":"2202.04785","title":"Multiclass histogram-based thresholding using kernel density estimation and scale-space representations","abstract":"We present a method for multiclass thresholding of histograms whose modes may overlap so strongly that they merge into a unimodal distribution. The histogram is approximated by a nonparametric kernel density (KD) estimate, a mixture of Gaussians with one component per bin and a common bandwidth, whose parameters are determined by Expectation-Maximization (EM) iterations. Because the estimate is a Gaussian mixture, the semigroup property of Gaussian convolution yields its scale-space representation in closed form, at bandwidths both larger and smaller than the fitted one. The algorithm increases or decreases the bandwidth until the number of local minima of the estimate equals the number of requested classes minus one, and returns the positions of those minima as the threshold values. We validate the method on synthetic histograms with known thresholds, and we apply it to the histogram of X-ray computed tomography images of a natural porous sample in which the three phases strongly overlap. The porosity computed from the resulting segmentation agrees with the direct experimental measurement to within 4%, whereas K-means clustering misestimates it by 52%.","originalAbstract":"We present a method for multiclass thresholding of histograms whose modes may overlap so strongly that they merge into a unimodal distribution. The histogram is approximated by a nonparametric kernel density (KD) estimate, a mixture of Gaussians with one component per bin and a common bandwidth, whose parameters are determined by Expectation-Maximization (EM) iterations. Because the estimate is a Gaussian mixture, the semigroup property of Gaussian convolution yields its scale-space representation in closed form, at bandwidths both larger and smaller than the fitted one. The algorithm increases or decreases the bandwidth until the number of local minima of the estimate equals the number of requested classes minus one, and returns the positions of those minima as the threshold values. We validate the method on synthetic histograms with known thresholds, and we apply it to the histogram of X-ray computed tomography images of a natural porous sample in which the three phases strongly overlap. The porosity computed from the resulting segmentation agrees with the direct experimental measurement to within 4%, whereas K-means clustering misestimates it by 52%.","authors":[{"name":"S. Korneev","affiliations":[],"orcid":null},{"name":"J. Gilles","affiliations":[],"orcid":null},{"name":"I. Battiato","affiliations":[],"orcid":null}],"doi":null,"relatedDoi":null,"source":"arXiv","status":"preprint","publishedAt":"2022-02-10","updatedAt":"2026-10-09T18:17:32Z","firstSeenAt":"2026-10-14T06:29:40.125Z","venue":null,"url":"https://arxiv.org/abs/2202.04785v2","version":2,"versions":[{"version":2,"updatedAt":"2026-10-09T18:17:32Z","url":"https://arxiv.org/abs/2202.04785v2"}],"provenance":[{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Asegmentation+OR+all%3Adelineation+OR+all%3Acontouring%29+AND+%28%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29+OR+all%3Aorgan+OR+all%3Alesion+OR+all%3Atumor+OR+all%3Atumour%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-14T06:29:40.125Z","sourceRecordId":"2202.04785v2","queryTrack":"segmentation"},{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Asegmentation+OR+all%3Adelineation+OR+all%3Acontouring%29+AND+%28%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%