%3A%22motion+tracking%22+OR+all%3A%22motion+correction%22+OR+all%3A%22image+alignment%22%29+AND+%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-22T01:39:36.053Z","sourceRecordId":"2409.14204v5","queryTrack":"registration"},{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Aregistration+OR+all%3A%22motion+estimation%22+OR+all%3A%22motion+tracking%22+OR+all%3A%22motion+correction%22+OR+all%3A%22image+alignment%22%29+AND+%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-23T07:44:53.133Z","sourceRecordId":"2409.14204v5","queryTrack":"registration"},{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Aregistration+OR+all%3A%22motion+estimation%22+OR+all%3A%22motion+tracking%22+OR+all%3A%22motion+correction%22+OR+all%3A%22image+alignment%22%29+AND+%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-24T01:45:07.862Z","sourceRecordId":"2409.14204v5","queryTrack":"registration"},{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Aregistration+OR+all%3A%22motion+estimation%22+OR+all%3A%22motion+tracking%22+OR+all%3A%22motion+correction%22+OR+all%3A%22image+alignment%22%29+AND+%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-25T01:20:40.752Z","sourceRecordId":"2409.14204v5","queryTrack":"registration"}],"pmid":null,"sources":["arXiv"],"affiliations":[],"tasks":["registration"],"modalities":["MRI","CT"],"organs":["胸部 / 肺"],"methods":[],"humanSignals":[],"tracks":["registration"],"evidence":[],"reviewStatus":"keyword_candidate","scope":"core","scopeReasons":["医学影像语境","计算方法线索：Deep Learning","计算方法线索：Deep learning","计算方法线索：neural network","计算方法线索：datasets"],"scopeClassifierVersion":"2026-10-21-scope-v1","taskClassifierVersion":"2026-10-21-diagnosis-v2"},{"id":"arxiv:2409.16183","arxivId":"2409.16183","title":"Expert-level vision-language foundation model for real-world radiology and comprehensive evaluation","abstract":"Radiology is a vital and complex component of modern clinical workflow and covers many tasks. Recently, vision-language (VL) foundation models in medicine have shown potential in processing multimodal information, offering a unified solution for various radiology tasks. However, existing studies either pre-trained VL models on natural data or did not fully integrate vision-language architecture and pretraining, often neglecting the unique multimodal complexity in radiology images and their textual contexts. Additionally, their practical applicability in real-world scenarios remains underexplored. Here, we present RadFound, a large and open-source vision-language foundation model tailored for radiology, that is trained on the most extensive dataset of over 8.1 million images and 250,000 image-text pairs, covering 19 major organ systems and 10 imaging modalities. To establish expert-level multimodal perception and generation capabilities, RadFound introduces an enhanced vision encoder to capture intra-image local features and inter-image contextual information, and a unified cross-modal learning design tailored to radiology. To fully assess the models' capability, we construct a benchmark, RadVLBench, including radiology interpretation tasks like medical vision-language question-answering, as well as text generation tasks ranging from captioning to report generation. We also propose a human evaluation framework. When evaluated on the real-world benchmark involving three representative modalities, 2D images (chest X-rays), multi-view images (mammograms), and 3D images (thyroid CT scans), RadFound significantly outperforms other VL foundation models on both quantitative metrics and human evaluation. In summary, the development of RadFound represents an advancement in radiology generalists, demonstrating broad applicability potential for integration into clinical workflows.","originalAbstract":"Radiology is a vital and complex component of modern clinical workflow and covers many tasks. Recently, vision-language (VL) foundation models in medicine have shown potential in processing multimodal information, offering a unified solution for various radiology tasks. However, existing studies either pre-trained VL models on natural data or did not fully integrate vision-language architecture and pretraining, often neglecting the unique multimodal complexity in radiology images and their textual contexts. Additionally, their practical applicability in real-world scenarios remains underexplored. Here, we present RadFound, a large and open-source vision-language foundation model tailored for radiology, that is trained on the most extensive dataset of over 8.1 million images and 250,000 image-text pairs, covering 19 major organ systems and 10 imaging modalities. To establish expert-level multimodal perception and generation capabilities, RadFound introduces an enhanced vision encoder to capture intra-image local features and inter-image contextual information, and a unified cross-modal learning design tailored to radiology. To fully assess the models' capability, we construct a benchmark, RadVLBench, including radiology interpretation tasks like medical vision-language question-answering, as well as text generation tasks ranging from captioning to report generation. We also propose a human evaluation framework. When evaluated on the real-world benchmark involving three representative modalities, 2D images (chest X-rays), multi-view images (mammograms), and 3D images (thyroid CT scans), RadFound significantly outperforms other VL foundation models on both quantitative metrics and human evaluation. In summary, the development of RadFound represents an advancement in radiology generalists, demonstrating broad applicability potential for integration into clinical workflows.","authors":[{"name":"Xiaohong Liu","affiliations":[],"orcid":null},{"name":"Guoxing Yang","affiliations":[],"orcid":null},{"name":"Yulin Luo","affiliations":[],"orcid":null},{"name":"Jiaji Mao","affiliations":[],"orcid":null},{"name":"Xiang Zhang","affiliations":[],"orcid":null},{"name":"Haibo Wang","affiliations":[],"orcid":null},{"name":"Zhiyang He","affiliations":[],"orcid":null},{"name":"Ming Gao","affiliations":[],"orcid":null},{"name":"Shanghang Zhang","affiliations":[],"orcid":null},{"name":"Jun Shen","affiliations":[],"orcid":null},{"name":"Guangyu Wang","affiliations":[],"orcid":null}],"doi":null,"relatedDoi":null,"source":"arXiv","status":"preprint","publishedAt":"2024-09-24","updatedAt":"2026-08-23T13:28:40Z","firstSeenAt":"2026-09-18T02:19:09.049Z","venue":null,"url":"https://arxiv.org/abs/2409.16183v2","vers