 functionality.",0,2,"2010-08-12T19:47:49.000Z",2,1,2,0,0,[],1,0,"gabehart/SimpleITK_backup",1,1,0,1,2,0,"2011-03-25T12:51:56.000Z",null,null,"SimpleITK ========= The goal of SimpleITK is to provide an abstraction layer to ITK that enables developers and users to access the powerful features of the Insight Toolkit in a more simplified manner. SimpleITK also is easily wrap-able in several languages including: * Python * Java * C# * Lua Wrapping is accomplished through SWIG, in principle, any language wrapped by SWIG should be applicable to SimpleITK. SimpleITK is licensed under the Apache License in the same way as ITK. ToDo: + Registration + CastImageFilter + Multiple input filters + Simple arithmetic filters"],["github:malaterre/tcpdump-dicom",0,"malaterre/tcpdump-dicom","https://github.com/malaterre/tcpdump-dicom","tcpdump",0,3,"2010-08-16T13:25:49.000Z",1,2,3,0,0,[],0,0,"malaterre/tcpdump-dicom",5,2,0,0,2,0,"2012-06-09T08:07:21.000Z",null,null,""],["github:mwaskom/pyroi",0,"mwaskom/PyROI","https://github.com/mwaskom/PyROI","Functional neuroimaging region of interest extraction and analysis in Python.",0,4,"2010-08-02T03:26:58.000Z",3,3,4,0,0,[],2,1,"mwaskom/PyROI",2,1,0,0,3,0,"2011-01-03T23:22:01.000Z",null,null,""],["github:pangyre/p5-picom",0,"pangyre/p5-picom","https://github.com/pangyre/p5-picom","Experimental DICOM implementation space.",0,5,"2010-08-28T01:13:38.000Z",4,4,5,0,0,[],0,0,"pangyre/p5-picom",1,0,0,0,4,0,"2013-06-26T02:14:21.000Z",null,null,""]]}
