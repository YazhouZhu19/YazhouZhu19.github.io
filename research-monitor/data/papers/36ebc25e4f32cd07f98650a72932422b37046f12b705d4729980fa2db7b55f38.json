[{"id":"arxiv:2502.12713","arxivId":"2502.12713","title":"Uncertainty Propagation for Echocardiography Clinical Metric Estimation via Contour Sampling","abstract":"Echocardiography plays a fundamental role in the extraction of clinical parameters (e.g. left ventricular volume and ejection fraction) required to determine the presence and severity of heart-related conditions. When deploying automated techniques for computing these parameters, uncertainty estimation is highly valuable for assessing their utility. Since clinical parameters are usually derived from segmentation maps, there is no clear path for converting pixel-wise uncertainty values into uncertainty estimates in the downstream clinical metric calculation. In this work, we propose a novel uncertainty estimation method based on contouring rather than segmentation. Our method explicitly predicts contour location uncertainty from which contour samples can be drawn. Finally, the sampled contours can be used to propagate uncertainty to clinical metrics. Our proposed method not only provides accurate uncertainty estimations for the task of contouring but also for the downstream clinical metrics on one public and two private cardiac ultrasound datasets containing a total of 1264 patients. Code is available at: https://github.com/ThierryJudge/contouring-uncertainty.","originalAbstract":"Echocardiography plays a fundamental role in the extraction of clinical parameters (e.g. left ventricular volume and ejection fraction) required to determine the presence and severity of heart-related conditions. When deploying automated techniques for computing these parameters, uncertainty estimation is highly valuable for assessing their utility. Since clinical parameters are usually derived from segmentation maps, there is no clear path for converting pixel-wise uncertainty values into uncertainty estimates in the downstream clinical metric calculation. In this work, we propose a novel uncertainty estimation method based on contouring rather than segmentation. Our method explicitly predicts contour location uncertainty from which contour samples can be drawn. Finally, the sampled contours can be used to propagate uncertainty to clinical metrics. Our proposed method not only provides accurate uncertainty estimations for the task of contouring but also for the downstream clinical metrics on one public and two private cardiac ultrasound datasets containing a total of 1264 patients. Code is available at: https://github.com/ThierryJudge/contouring-uncertainty.","authors":[{"name":"Thierry Judge","affiliations":[],"orcid":null},{"name":"Olivier Bernard","affiliations":[],"orcid":null},{"name":"Nicolas Duchateau","affiliations":[],"orcid":null},{"name":"Woo-Jin Cho Kim","affiliations":[],"orcid":null},{"name":"Alberto Gomez","affiliations":[],"orcid":null},{"name":"Arian Beqiri","affiliations":[],"orcid":null},{"name":"Agisilaos Chartsias","affiliations":[],"orcid":null},{"name":"Pierre-Marc Jodoin","affiliations":[],"orcid":null}],"doi":null,"relatedDoi":null,"source":"arXiv","status":"preprint","publishedAt":"2025-02-18","updatedAt":"2026-10-14T14:04:28Z","firstSeenAt":"2026-10-16T01:32:10.349Z","venue":null,"url":"https://arxiv.org/abs/2502.12713v2","version":2,"versions":[{"version":2,"updatedAt":"2026-10-14T14:04:28Z","url":"https://arxiv.org/abs/2502.12713v2"}],"provenance":[{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Asegmentation+OR+all%3Adelineation+OR+all%3Acontouring%29+AND+%28%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29+OR+all%3Aorgan+OR+all%3Alesion+OR+all%3Atumor+OR+all%3Atumour%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-10-16T01:32:10.