[[1,{"id":"doi:10.1007/978-3-031-43898-1_36","title":"Boundary-weighted logit consistency improves calibration of segmentation networks.","abstract":"Neural network prediction probabilities and accuracy are often only weakly-correlated. Inherent label ambiguity in training data for image segmentation aggravates such miscalibration. We show that logit consistency across stochastic transformations acts as a spatially varying regularizer that prevents overconfident predictions at pixels with ambiguous labels. Our boundary-weighted extension of this regularizer provides state-of-the-art calibration for prostate and heart MRI segmentation.","authors":[["Neerav Karani",null,["Massachusetts Institute of Technology."],"Karani N"],["Neel Dey",null,["Massachusetts Institute of Technology."],"Dey N"],["Polina Golland",null,["Massachusetts Institute of Technology."],"Golland P"]],"authorString":"Karani N, Dey N, Golland P.","doi":"10.1007/978-3-031-43898-1_36","pmid":"42959760","pmcid":"PMC13718338","source":"Europe PMC","sourceCollection":"MED","status":"published","publishedAt":"2023-10-01","updatedAt":"2026-10-31","firstSeenAt":"2026-11-04T19:19:26.001Z","venue":"Medical image computing and computer-assisted intervention : MICCAI ... International Conference on Medical Image Computing and Computer-Assisted Intervention","url":"https://doi.org/10.1007/978-3-031-43898-1_36","version":null,"versions":[],"provenance":[[1685,"2026-11-04T19:19:26.001Z","segmentation","42959760",15,{"publicationDates":{"firstPublicationDate":"2023-10-01","electronicPublicationDate":"2023-10-01","firstIndexDate":"2026-10-31"},"publicationDateField":"firstPublicationDate"}],[1685,"2026-11-04T19:56:39.599Z","segmentation","42959760",15,{"publicationDates":{"firstPublicationDate":"2023-10-01","electronicPublicationDate":"2023-10-01","firstIndexDate":"2026-10-31"},"publicationDateField":"firstPublicationDate"}],[1685,"2026-11-04T21:59:52.449Z","segmentation","42959760",15,{"publicationDates":{"firstPubl