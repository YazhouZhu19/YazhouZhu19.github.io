[{"id":"arxiv:2311.08493","arxivId":"2311.08493","title":"Performance of Machine Learning Classification in Sonomammogram Images using BI-RADS","abstract":"This research aims to investigate the classification accuracy of various state-of-the-art image classification models across different categories of breast ultrasound images, as defined by the Breast Imaging Reporting and Data System (BI-RADS). To achieve this, we used 2,945 sonomammogram images for training and 936 images for validation, with the source cohort reported as comprising 1,540 patients. In order to conduct a thorough analysis, we employed six advanced classification architecture families, including VGG19 \\cite{simonyan2014very}, ResNet50 \\cite{he2016deep}, GoogleNet \\cite{szegedy2015going}, ConvNeXt \\cite{liu2022convnet}, EfficientNet \\cite{tan2019efficientnet}, and Vision Transformers (ViT) \\cite{dosovitskiy2020image}, instead of traditional machine learning models. We evaluate models in three different settings: full fine-tuning, linear evaluation and training from scratch. Our findings demonstrate the effectiveness and capability of our Computer-Aided Diagnosis (CAD) system, with a remarkable accuracy of 76.39\\% and an F1 score of 67.94\\% in the full fine-tuning setting. Our findings indicate the potential for enhanced diagnostic accuracy in the field of breast imaging, providing a solid foundation for future endeavors aiming to improve the precision and reliability of CAD systems in medical imaging.","originalAbstract":"This research aims to investigate the classification accuracy of various state-of-the-art image classification models across different categories of breast ultrasound images, as defined by the Breast Imaging Reporting and Data System (BI-RADS). To achieve this, we used 2,945 sonomammogram images for training and 936 images for validation, with the source cohort reported as comprising 1,540 patients. In order to conduct a thorough analysis, we employed six advanced classification architecture families, including VGG19 \\cite{simonyan2014very}, ResNet50 \\cite{he2016deep}, GoogleNet \\cite{szegedy2015going}, ConvNeXt \\cite{liu2022convnet}, EfficientNet \\cite{tan2019efficientnet}, and Vision Transformers (ViT) \\cite{dosovitskiy2020image}, instead of traditional machine learning models. We evaluate models in three different settings: full fine-tuning, linear evaluation and training from scratch. Our findings demonstrate the effectiveness and capability of our Computer-Aided Diagnosis (CAD) system, with a remarkable accuracy of 76.39\\% and an F1 score of 67.94\\% in the full fine-tuning setting. Our findings indicate the potential for enhanced diagnostic accuracy in the field of breast imaging, providing a solid foundation for future endeavors aiming to improve the precision and reliability of CAD systems in medical imaging.","authors":[{"name":"Malitha Gunawardhana","affiliations":[],"orcid":null},{"name":"Norbert Zolek","affiliations":[],"orcid":null}],"doi":null,"relatedDoi":null,"source":"arXiv","status":"preprint","publishedAt":"2023-11-14","updatedAt":"2026-09-17T00:27:36Z","firstSeenAt":"2026-09-18T02:19:09.049Z","venue":null,"url":"https://arxiv.org/abs/2311.08493v2","version":2,"versions":[{"version":2,"updatedAt":"2026-09-17T00:27:36Z","url":"https://arxiv.org/abs/2311.08493v2"}],"provenance":[{"queryUrl":"https://export.arxiv.org/api/query?search_query=%28all%3Adiagnosis+OR+all%3Adetection+OR+all%3Aclassification+OR+all%3Ascreening%29+AND+%28all%3A%22medical+imaging%22+OR+all%3A%22medical+image%22+OR+all%3Aradiology+OR+all%3Aradiologist+OR+all%3AMRI+OR+all%3A%22computed+tomography%22+OR+all%3Aultrasound+OR+all%3Ahistopathology+OR+all%3Amammography+OR+all%3Aretinal+OR+all%3Afundus+OR+all%3Aradiograph+OR+all%3Aendoscopy+OR+all%3A%22positron+emission%22%29&start=0&max_results=100&sortBy=lastUpdatedDate&sortOrder=descending","collectedAt":"2026-09-18T02:19:09.049Z","sourceRecordId":"2311.08493v2","queryTrack":"diagnosis"},{"que