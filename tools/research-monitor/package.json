{
  "name": "medical-research-monitor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/copy-data.ts && tsx scripts/measure-budget.ts",
    "measure": "tsx scripts/measure-budget.ts",
    "preview": "vite preview --host 127.0.0.1",
    "collect": "tsx scripts/collect.ts",
    "collect:signals": "tsx scripts/collect-signals.ts",
    "test": "node --import tsx --test tests/*.test.ts && node tests/run-local.mjs",
    "e2e:prepare": "vite build --outDir .e2e-dist && tsx e2e/build-fixtures.ts",
    "e2e": "npm run e2e:prepare && playwright test",
    "e2e:full-data": "tsx e2e/full-data-audit.ts",
    "format": "prettier --write lib components scripts styles hooks tests e2e main.tsx vite.config.ts playwright.config.ts",
    "format:check": "prettier --check lib components scripts styles hooks tests e2e main.tsx vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "OEVRYN Engine — Research Intelligence for Medical Image Analysis, connecting papers, open-source code and public updates for research direction, PI and team outlooks."
}
